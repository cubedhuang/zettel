// every arithmetic and bitwise operator has a compound form
x := 10
x += 5
echo x // expect: 15
x -= 3
echo x // expect: 12
x *= 2
echo x // expect: 24
x /= 4
echo x // expect: 6
x %= 4
echo x // expect: 2
x -= 5
x %%= 4
echo x // expect: 1
x += 1
x ^= 3
echo x // expect: 8
x |= 3
echo x // expect: 11
x &= 6
echo x // expect: 2
x ~= 7
echo x // expect: 5
x <<= 2
echo x // expect: 20
x >>= 1
echo x // expect: 10

// strings concatenate
s := "a"
s += "b"
echo s // expect: "ab"

// locals and captured variables
fn counter() {
    n := 0
    fn next() {
        n += 1
        return n
    }
    return next
}
next := counter()
next()
echo next() // expect: 2

// an element's array and index are evaluated once
calls := 0
xs := [1, 2, 3]
fn index() {
    calls += 1
    return 1
}
xs[index()] *= 10
echo xs    // expect: [1, 20, 3]
echo calls // expect: 1

// it works in conditions' initializers
if y := 1; y < 2 { echo "init" } // expect: "init"
n := 0
while n < 10 { n += 3 }
echo n // expect: 12
