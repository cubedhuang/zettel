// statements recover at the end of their line
a, 1 := 2, 3 // error: can only declare identifiers
b = 1, 2     // error: more values than targets
echo (1 +)   // error: expected expression, got ')'
f(1,,2)      // error: expected expression, got ','
return 1 2   // error: expected end of statement, got a number
lbl: echo 1  // error: can only label blocks, if statements, and while loops, got 'echo'
}            // error: expected statement, got '}'

// recovery skips the blocks of a broken statement
fn (a) {      // error: expected an identifier, got '('
    return a
}
if x := 1 {   // error: expected ';', got '{'
    echo x
}
{
    while (1 + ) { echo 1 } // error: expected expression, got ')'
    echo "still in the block"
}

// 'else' on the next line is still parsed as part of the if
if true { }
else if false { } // error: 'else' must be on the same line as the '}' before it
else { }      // error: 'else' must be on the same line as the '}' before it
else { }      // error: expected statement, got 'else'

// indexing needs an index, and arrays need their closing bracket
empty_index := []
echo empty_index[] // error: expected expression, got ']'
echo [1, 2;        // error: expected ']', got ';'

// a rest parameter is last, and spreading only happens in lists
fn rest_first(..a, b) {} // error: a rest parameter must be the last parameter
fn rest_no_name(..) {}   // error: expected an identifier, got ')'
spread_alone := ..[1]    // error: expected expression, got '..'

// unclear operator combinations need parentheses
chained := 1 < 2 < 3     // error: comparisons can't be chained; use 'and' or parentheses
chained_eq := 1 < 2 == 3 // error: comparisons can't be chained; use 'and' or parentheses
mixed := 1 + 2 & 3       // error: '+' and '&' need parentheses to show which applies first
mixed_bits := 1 | 2 & 3  // error: '|' and '&' need parentheses to show which applies first
same_level := 1 | 2 ~ 3  // error: '~' and '|' need parentheses to show which applies first
shifted := 1 << 2 - 1    // error: '-' and '<<' need parentheses to show which applies first
power := -2 ^ 2          // error: '-' and '^' need parentheses to show which applies first

// compound assignment takes one target and one value
compound_a, compound_b += 1 // error: '+=' takes one target and one value
compound_c -= 1, 2          // error: '-=' takes one target and one value

// strings end on the same line
unterminated := "no end // error: expected expression, got an unterminated string

// a trailing operator continues the expression onto the next line
echo 1 +     // error: expected expression, got end of input
